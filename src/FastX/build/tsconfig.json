{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "cesium": ["../../../node_modules/cesium"]
    }
  },
  "include": [
    "entry.ts",
    "runtime/**/*.ts",
    "stubs/**/*.ts",
    "../**/*.ts"
  ],
  "exclude": [
    "../components/**/*.vue",
    "../Draw/runBatchCollectionsSmoke.ts"
  ]
}
